rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'createdAt']) &&
        data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
        data.name is string && data.name.size() <= 150 &&
        data.email is string && data.email.size() <= 254 &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Users Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Strict privacy: do not expose user directory
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUser(incoming());
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt;
      allow delete: if false; // Deletion handled via controlled admin/retention routines
    }

    // Instagram Accounts Collection: /instagram_accounts/{instagramAccountId}
    match /instagram_accounts/{instagramAccountId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false; // Securely written by Firebase Cloud Function backend only
    }
  }
}
