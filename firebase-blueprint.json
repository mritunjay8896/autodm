{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile document stored on authentication",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication User ID",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 150
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the user profile was created"
        }
      },
      "required": ["uid", "name", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection storing multi-tenant user accounts"
    }
  }
}
