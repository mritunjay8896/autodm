# ==========================================
# AutoDM - Environment Configuration
# Copy this file to .env and populate with your credentials
# ==========================================

# Server & Hosting Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Firebase Client SDK Configuration (Firestore + Auth)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_DATABASE_ID="(default)"

# Meta for Developers / Instagram Graph API Configuration
INSTAGRAM_APP_ID="1097121733196692"
INSTAGRAM_APP_SECRET="your_meta_app_secret"
INSTAGRAM_ACCESS_TOKEN="your_instagram_graph_api_access_token"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="auto_dm_webhook_secret_2026"
